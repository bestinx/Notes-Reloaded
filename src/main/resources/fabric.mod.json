{
  "schemaVersion": 1,
  "id": "notes",
  "version": "${version}",
  "name": "Notes Reloaded",
  "description": "Clientside in-game notepad. Revived fork: scrollable viewer, search, in-game settings, unsaved-change protection and a refreshed UI.",
  "authors": [
    "ChaosTheDude",
    "Notes Reloaded fork"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/notes",
    "sources": "https://github.com/MattCzyr/Note"
  },
  "license": "CC BY-NC-SA 4.0",
  "accessWidener": "notes.accesswidener",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.chaosthedude.notes.Notes"
    ]
  },
  "mixins": [
    "notes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}"
  }
}
